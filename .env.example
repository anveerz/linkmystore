# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Optional: redirect helper URL used by /api/payment-accounts/initiate
RAZORPAY_ONBOARDING_URL=https://dashboard.razorpay.com/signin?screen=signup
# Optional: full webhook endpoint URL. If unset, app derives
# <NEXT_PUBLIC_APP_URL>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_URL=

# V3 payments security
# Required in staging/prod. Used to encrypt/decrypt seller gateway secrets in payment_accounts.
PAYMENT_ACCOUNT_ENCRYPTION_KEY=

# AI / integrations
GEMINI_API_KEY=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PROVIDER=generic
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
AMAZON_AFFILIATE_TAG=linkmystore-21
FLIPKART_AFFILIATE_ID=linkmystore

# App
NEXT_PUBLIC_APP_URL=https://linkmystore.in

# Comma-separated allowlist for internal-only tools such as /internal/outreach
INTERNAL_ADMIN_EMAILS=
PLATFORM_FEE_PERCENT=4
RESEND_API_KEY=
# Branded sender used for seller and buyer order emails.
RESEND_FROM_EMAIL=LinkMyStore <contact@linkmystore.in>

# Custom Google OAuth (domain-first login flow)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override. If empty, defaults to <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# V3 feature flags
V3_CHECKOUT_UNIFIED=true
V3_PG_PRIMARY=true
V3_UPI_FALLBACK_LIMITS=true
V3_TRUST_SURFACES=true

# V3 fallback limits (defaults shown)
UPI_FALLBACK_DAYS=30
UPI_FALLBACK_MAX_ORDER_PAISA=500000
UPI_FALLBACK_MONTHLY_GMV_PAISA=5000000

# Optional automation token for scripted seller verify-upi in staging E2E.
# Keep empty in production unless you explicitly need scripted verification.
V3_AUTOMATION_TOKEN=
# Optional secret for seller-confirm and buyer-delivery email links.
# If empty, the app falls back to SUPABASE_SERVICE_ROLE_KEY.
ORDER_EMAIL_ACTION_SECRET=

# Optional staging E2E inputs (used by scripts/v3/staging-e2e.cjs)
E2E_CREATOR_ID=
E2E_PRODUCT_ID=
E2E_UPI_ID=
E2E_PG_KEY_ID=
E2E_PG_KEY_SECRET=
E2E_PG_WEBHOOK_SECRET=
